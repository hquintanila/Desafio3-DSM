<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E0E0E0"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Fila Superior: Badge Tipo, Rating y Botón Favorito -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvTipoBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#E3F2FD"
                android:textColor="#1976D2"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                tools:text="Video" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvCalificacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F57C00"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp"
                tools:text="⭐ 4.8 (12)" />

            <ImageButton
                android:id="@+id/btnFavorito"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/btn_favorite_add"
                android:src="@android:drawable/btn_star_big_off"
                app:tint="#9E9E9E" />

        </LinearLayout>

        <!-- Contenido Central: Imagen, Categoría y Título -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <ImageView
                android:id="@+id/ivImagenRecurso"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:scaleType="centerCrop"
                android:background="#EAEAEA"
                android:contentDescription="@string/app_name"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCategoria"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#757575"
                    android:textStyle="bold"
                    android:layout_marginBottom="2dp"
                    tools:text="Categoría: Libro" />

                <TextView
                    android:id="@+id/tvTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:maxLines="2"
                    android:ellipsize="end"
                    tools:text="Curso de Kotlin Intermedio" />

            </LinearLayout>

        </LinearLayout>

        <!-- Descripción Corta -->
        <TextView
            android:id="@+id/tvDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#616161"
            android:maxLines="3"
            android:ellipsize="end"
            android:layout_marginBottom="12dp"
            tools:text="Aprende sobre Corrutinas, Retrofit y Kotlin DSL con ejemplos prácticos." />

        <!-- Barra Inferior de Acciones: Calificar y Abrir Enlace -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/btnCalificar"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/btn_rate"
                android:textSize="12sp"
                android:paddingHorizontal="8dp" />

            <Button
                android:id="@+id/btnAbrirEnlace"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/btn_open_link"
                android:textSize="12sp"
                android:paddingHorizontal="12dp" />

        </LinearLayout>

        <!-- Panel Exclusivo para Docentes (Editar y Eliminar Recurso) -->
        <LinearLayout
            android:id="@+id/layoutDocenteAcciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:visibility="gone"
            tools:visibility="visible">

            <Button
                android:id="@+id/btnEditarRecurso"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/btn_edit"
                android:textColor="#1565C0"
                android:textSize="12sp"
                android:paddingHorizontal="8dp" />

            <Button
                android:id="@+id/btnEliminarRecurso"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/btn_delete"
                android:textColor="#C62828"
                android:textSize="12sp"
                android:paddingHorizontal="8dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
